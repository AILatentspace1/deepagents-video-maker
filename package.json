{
  "name": "deepagents-video-maker",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "ui:dev": "pnpm --filter deepagent-video-maker-ui dev",
    "agent:dev": "cd web-ui && uv run langgraph dev --port 2026",
    "golden:script": "uv run python scripts/run_golden_demo_smoke.py",
    "golden:render": "uv run python scripts/run_golden_render_smoke.py",
    "golden:playable": "uv run python scripts/run_golden_playable_smoke.py",
    "test:py": "uv run pytest tests/deepagents_video_maker",
    "harness:validate": "uv run better-harness validate harness/video-maker-minimal.toml",
    "harness:run": "uv run better-harness run harness/video-maker-minimal.toml --output-dir runs/baseline --max-iterations 1",
    "ui:build": "node scripts/build-ui.mjs"
  }
}
